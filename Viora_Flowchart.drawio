<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="pKBlqWwh2gArokeisl8z">
    <mxGraphModel dx="2239" dy="1354" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Viora Bills - Billing and Invoice Management System\n\n&#39; ===== PROFESSIONAL DESIGN =====\nleft to right direction\n\nskinparam backgroundColor #F8FAFC\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam ArrowColor #64748B\nskinparam ArrowThickness 1.5\nskinparam activityBorderThickness 1.2\nskinparam roundcorner 15\n\nskinparam activity {\n  BackgroundColor #DBEAFE\n  BorderColor #3B82F6\n  FontColor #1E3A8A\n  DiamondBackgroundColor #FEF3C7\n  DiamondBorderColor #F59E0B\n  DiamondFontColor #92400E\n  StartColor #16A34A\n  EndColor #DC2626\n  BarColor #94A3B8\n}\n\n&#39; ===== START =====\nstart\n#DCFCE7:Open Viora Bills;\n#DBEAFE:Display Dashboard;\n#E2E8F0:Select Module;\n\n&#39; ===== MODULE ROUTING =====\nif (Which module?) then (Customers)\n\n  #DBEAFE:Manage Customers;\n  :Add / Edit / Search / View;\n  :Validate customer details;\n  #DCFCE7:Save customer record;\n\nelseif (Products)\n\n  #EDE9FE:Manage Products;\n  :Add or edit product;\n  :Set price, unit and GST rate;\n  :Validate product details;\n  #DCFCE7:Save product record;\n\nelseif (Invoices)\n\n  #DBEAFE:Create Invoice;\n  :Select customer and products;\n  :Enter quantities;\n  :Retrieve prices and GST rates;\n  :Calculate subtotal, discount, GST and total;\n  #FEF3C7:Review invoice details;\n\n  while (Details incorrect?) is (Yes)\n    #FEE2E2:Correct invoice details;\n    :Recalculate total;\n    #FEF3C7:Review invoice again;\n  endwhile (No)\n\n  #DCFCE7:Save invoice and items;\n  #EDE9FE:Generate invoice PDF;\n  :Preview / Download / Print;\n  #DCFCE7:Issue invoice;\n\n  if (Record payment now?) then (Yes)\n    #D1FAE5:Continue to shared payment workflow;\n  else (Later)\n    #FEE2E2:Set status to UNPAID;\n    :Keep balance outstanding;\n  endif\n\nelseif (Payments)\n\n  #D1FAE5:Open Payments Module;\n  #D1FAE5:Continue to shared payment workflow;\n\nelseif (Reports)\n\n  #CCFBF1:Retrieve invoice and payment records;\n  :Calculate sales and outstanding dues;\n  #DCFCE7:Display financial reports;\n\nelse (Settings)\n\n  #EDE9FE:Manage Settings;\n  :Update company details;\n  :Configure tax and invoice settings;\n  #DCFCE7:Validate and save settings;\n\nendif\n\n&#39; ===== PAYMENT PROCESSING =====\n:Open shared payment workflow;\n\n#D1FAE5:Select invoice;\n:Enter payment amount and date;\n:Validate payment details;\n\nif (Payment valid?) then (Yes)\n\n  #DCFCE7:Save payment record;\n  :Recalculate total paid and balance;\n\n  if (Balance &lt;= 0?) then (Yes)\n    #BBF7D0:Set status to PAID;\n  else (No)\n    #FEF3C7:Set status to PARTIALLY PAID;\n  endif\n\n  :Update invoice and payment records;\n  :Refresh outstanding reports;\n\nelse (No)\n\n  #FEE2E2:Show validation error;\n  :Correct payment details;\n\nendif\n\n#DBEAFE:Return to Dashboard;\nstop\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="prCs98lMtkItzL8K4XO0-767">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;editIcon=1;groupPadding=10;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="2031" width="1558" x="20" y="280" as="geometry" />
          </mxCell>
        </UserObject>
